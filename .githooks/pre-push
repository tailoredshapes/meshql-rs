#!/usr/bin/env bash
# Pre-push hook: cargo fmt, clippy, build, and tests.
#
# The testcontainer-backed DB adapter certs (meshql-mongo / meshql-mysql /
# meshql-postgres) are excluded here — each spins up real Docker containers
# and the full set adds several minutes, which is too slow for a local
# pre-push gate. CI (.github/workflows/ci.yml) runs the complete suite,
# including those, on every push/PR to main. Run them locally with
# `cargo test -p meshql-mongo -p meshql-mysql -p meshql-postgres` before
# pushing a change that touches those adapters.
set -e

echo "==> Checking formatting..."
cargo fmt --all -- --check

echo "==> Running clippy..."
cargo clippy --workspace -- -D warnings

echo "==> Building..."
cargo build --workspace

echo "==> Running tests..."
cargo test --workspace --no-fail-fast \
  --exclude meshql-mongo \
  --exclude meshql-mysql \
  --exclude meshql-postgres

echo "==> All checks passed."
